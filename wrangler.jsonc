// Cloudflare settings for caish.org. See README.md, "Hosting".
// The site is static files only: Cloudflare publishes the repository folder as it is.
{
  "name": "caish-website",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
