// Cloudflare settings for caish.org. See README.md, "Hosting".
// The site is static files only: Cloudflare publishes the repository folder as it is.
{
  "name": "caish-website",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Branch builds run `npx wrangler preview`, which stops unless this block exists.
  // It stays empty: the settings above apply to previews too.
  "previews": {}
}
