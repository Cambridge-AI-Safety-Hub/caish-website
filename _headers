# Response headers for caish.org on Cloudflare.
# Format: a path pattern, then indented "Name: value" lines.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://tally.so; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://forms-eu1.hsforms.com https://joggzpdemdmyvnlhtjte.supabase.co; frame-src https://tally.so https://www.youtube.com; media-src 'self' https://pub-fd3e7e854dc549da85f015f509d5ec9a.r2.dev; base-uri 'self'; form-action 'self' https://tally.so https://share-eu1.hsforms.com

# Images never change once uploaded, so browsers may keep them for a year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# styles.css and enhancements.js carry a ?v= version that cache-bust.sh updates on every deploy
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/enhancements.js
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be re-checked
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Certificate data
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Unlisted pages, kept out of search engines
/participants/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache, no-store, must-revalidate
/hardware/schedule/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache, no-store, must-revalidate
